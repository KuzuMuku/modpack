		}
		{
			dependencies: ["2378779C503E0B15"]
			description: ["如果你打算长期在下界活动，做一个重生锚可以显著降低跑尸成本。记得再带萤石为它充能。"]
			id: "1B01000000000004"
			tasks: [{
