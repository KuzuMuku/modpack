	quests: [
		{
			dependencies: ["1E01000000000010"]
			description: [
				"枪械线适合想要稳定远程火力的玩家，但别一上来就奔着大狙和机枪。"
				"先用手枪或便宜步枪练手，再准备一把近距离副枪，等弹药和换弹节奏熟了，再考虑狙击、机枪或火箭筒。"
				"看枪时先看材料门槛：铁和木头是入门，金、青金石和石英开始进入中期，钻石、烈焰棒和下界合金就要认真考虑成本。"
			]
			id: "4402000000000000"
			optional: true
			tasks: [{
				id: "4402000000000010"
				title: "如何使用枪械词典"
				type: "checkmark"
			}]
			x: 6.5d
			y: -13.0d
		}
		{
			dependencies: ["4402000000000000"]
			description: ["枪匠台是 TACZ 武器线的基础工作台。先有它，后面才谈得上配枪、弹药和测试。"]
			id: "01ADD7C301E0A595"
			tasks: [{
				id: "434229B2EE6E8B4A"
				item: "tacz:gun_smith_table"
				type: "item"
			}]
			title: "枪匠台"
			x: 6.5d
			y: -12.0d
		}
		{
			description: ["把靶子立起来，确认你的枪械线已经从“做出来”走到“真正开始调校和实战测试”。"]
			id: "4401000000000005"
			tasks: [{
				id: "4401000000000015"
				item: "tacz:target"
