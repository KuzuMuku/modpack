		}
		{
			dependencies: ["2378779C503E0B15"]
			description: ["进入下界后，优先去图鉴里看“下界器官”。这一组偏近战爆发、火焰法斗和高热续航，是中期最直接的战斗强化来源。"]
			id: "1B01000000000005"
