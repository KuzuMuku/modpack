	quest_links: [ ]
	quests: [
		{
			dependencies: ["1E01000000000010"]
			description: [
				"Create 是科技宅家流最早能成型的底盘。它不会直接替你打穿维度，但能把手搓、搬运、加工和补给慢慢交给机器。"
				"刚开始别急着造大工厂。先做安山合金和外壳，再让水车或风车转起来；只要轴、齿轮、皮带能把动力送到机器上，你就已经跨过了 Create 最重要的门槛。"
				"第一批值得自动化的东西很朴素：磨矿、压板、搅拌、切木头、搬物品。它们会让你少花时间重复劳动，把精力留给远征和器官材料。"
				"卡住时先看机器有没有动力，再看方向对不对，最后再看物品有没有被送到正确位置。Create 大多数问题都不是配方难，而是机器没有连成一条会动的线。"
			]
			id: "3F01000000000000"
			tasks: [{
				id: "3F01000000000100"
				title: "路线导读"
				type: "checkmark"
			}]
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["5788967FDC7A21DC"]
			description: ["黄铜外壳意味着你已经从安山阶段跨入更完整的中期机械体系。很多真正好用的自动化都会从这里展开。"]
			id: "14A7655D25625BC9"
			shape: "gear"
			size: 2.0d
			tasks: [{
				id: "7D74DDDBFC11EF01"
				item: "create:brass_casing"
				type: "item"
			}]
			x: -2.0d
			y: 5.0d
		}
		{
			dependencies: ["3F01000000000000"]
			description: ["安山合金是你的第一块机械底材。做出它以后，就可以开始把重复手工活一点点交给机器。"]
			id: "1DEF6A0040BC9BE3"
			tasks: [{
				id: "2227D2AE5D1A91BE"
				item: "create:andesite_alloy"
				type: "item"
			}]
			x: 0.0d
			y: 2.5d
		}
		{
			dependencies: ["1DEF6A0040BC9BE3"]
			description: ["安山外壳说明第一批机器骨架已经齐了。下一步不是堆机器，而是先让动力能稳定传过去。 "]
			id: "5788967FDC7A21DC"
			shape: "gear"
			size: 2.0d
			tasks: [{
				id: "57E0D74F30D2310F"
