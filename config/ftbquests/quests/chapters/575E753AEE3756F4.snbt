	quest_links: [ ]
	quests: [
		{
			dependencies: ["1E01000000000010"]
			description: [
				"AE2 不是必做，但当箱子开始乱、材料开始多、机器开始互相要零件时，它会非常值得投入。"
				""
				"如果你是第一次玩 AE2，先抓一条线：先找陨石，拿到石英和模具。然后找方法供电，让充能器工作，做压印器来压印处理器，最后制作元件，驱动器和终端，接成一个能用的 ME 网络。"
				""
				"不要一开始就追完整自动化。先让所有东西能被一个终端看见，你的基地整理压力就会立刻下降。"
				""
				"等你已经习惯用终端取放物品，再去碰接口、样板供应器、分子组装器和无线终端，进一步组装自动化系统。"
			]
			id: "5702000000000000"
			tasks: [{
				id: "5702000000000100"
				title: "路线导读"
				type: "checkmark"
			}]
			x: -3.5d
			y: -4.0d
		}
		{
			dependencies: ["5702000000000000"]
			description: [
				"AE2 第一个目标是陨石。AE2设定为外星科技，关键的材料和模具都要从陨石获得。"
				""
				"找到陨石后先把模具带回家，不要在外面边探索边临时加工，AE2 前期最怕材料散在背包里。"
			]
			id: "4A5AF0FDE37A1740"
			tasks: [{
				id: "5B74A253919CD335"
				item: "ae2:meteorite_compass"
				type: "item"
			}]
			x: -3.5d
			y: 0.0d
		}
		{
			dependencies: ["100C39957991A397"]
			description: ["充能器是 AE2 最基础的开机机器。提供供电后"]
			id: "23627E658125872D"
			tasks: [{
				id: "7B0050EF87D72EDA"
				item: "ae2:charger"
				type: "item"
			}]
			x: 1.5d
			y: 2.0d
		}
		{
			dependencies: ["4A5AF0FDE37A1740"]
			description: [
				"四种压印模具是 AE2 处理器线的钥匙。"
				"AE2 很多东西看起来杂，但本质上大量内容都在围绕处理器运转。"
				"只要你理解这些压印模具是拿来生产哪几类处理器的，后面整张任务图就会变得有顺序。"
			]
			id: "0D6AAD8761B79C7B"
			tasks: [
				{
					id: "2EED3275BBDA8E69"
					item: "ae2:calculation_processor_press"
					type: "item"
				}
				{
					id: "128827C9F8D2BA67"
					item: "ae2:engineering_processor_press"
					type: "item"
				}
				{
					id: "6E01FAB89B1EDBDE"
					item: "ae2:logic_processor_press"
					type: "item"
				}
				{
					id: "397FA5713BACE9EF"
					item: "ae2:silicon_press"
					type: "item"
				}
			]
			x: -1.0d
			y: 0.0d
		}
		{
			dependencies: ["0D6AAD8761B79C7B"]
			description: [
				"压印器是 AE2 入门阶段最值得优先自动化的机器。"
				"前期你可以手搓着做处理器，但很快就会发现这一步最耗人。"
				"所以新手学 AE2 时，应该尽早形成一个概念：压印器不是临时工作台，而是以后必须批量运转的生产节点。"
			]
			id: "0B4873951926F6EA"
			tasks: [{
				id: "39495FAD10289DB6"
				item: "ae2:inscriber"
				type: "item"
			}]
