	quests: [
		{
			dependencies: ["1E0100000000000D"]
			description: [
				"这里保留完整器官图鉴，方便你以后按来源和方向查找。"
				"第一次看不要试图全部记住。先记住自己现在能去哪里，再看那一块区域能提供什么器官。"
			]
			id: "4E56DD1FD44ED6D5"
			shape: "gear"
			size: 2.0d
			subtitle: "来源 x 方向"
			tasks: [{
				id: "427868E5297F5CB8"
				title: "器官总览"
				type: "checkmark"
			}]
			x: -13.0d
			y: -6.0d
		}
		{
			description: [
				"§6把这一页当地图，不要当考试大纲。§r"
				"先看来源：村庄、沙漠、沼泽、海洋、下界、幽匿。只要你现在能稳定到达某个地方，就先看那一组。"
				"再看方向：近战、弓箭、法术、资源、辅助。你缺什么，就只读那一列。"
				"§a真正需要背下来的不是器官名字，而是“我现在能刷哪里、这组能补什么短板”。§r"
			]
			id: "39E4121EB1560BEF"
			tasks: [{
				id: "1E99F311784F4B9F"
				title: "如何使用图鉴"
				type: "checkmark"
			}]
			x: -17.0d
			y: -6.0d
		}
		{
			description: [
				"§6前期器官是补短板，不是追毕业。§r"
				"第一件器官最好能立刻改变体验：让你打怪更快、活得更久、跑图更稳，或者下矿少回家。"
				"主世界阶段优先看容易接触的来源：村庄、掠夺者、沼泽、沙漠、丛林、海洋和繁茂洞穴。进下界后，再把一两个位置换成更适合高热、爆发或持续战斗的器官。"
				"到暮色森林时，再开始考虑成套构筑：近战围绕站场，远程围绕距离，法术围绕施法节奏。"
			]
			id: "2CCF8FBF20ACD0D6"
			tasks: [{
				id: "3780C51DCBEEED6D"
				title: "前期器官怎么搭"
				type: "checkmark"
			}]
			x: -17.0d
			y: -4.0d
		}
		{
			description: ["近战器官主要解决贴脸输出、承伤、击退和换血。总是被怪围住或打 Boss 刮痧时，先看这里。"]
			id: "605D1EA8AC5C59A4"
			tasks: [{
				id: "425179EBABA2E934"
				title: "近战"
				type: "checkmark"
			}]
			x: -8.0d
			y: -6.0d
		}
		{
			description: ["弓箭器官适合远程拉扯、命中收益和弹药/箭矢节奏。喜欢保持距离、不想频繁贴脸，就看这里。"]
			id: "450DBAFAC02415DB"
			tasks: [{
				id: "68BAF54FF5BEAE68"
				title: "弓箭"
				type: "checkmark"
			}]
			x: -4.0d
			y: -6.0d
		}
		{
			description: ["法术器官会影响法力、冷却、法术强度和异常效果。主修 Ars 或 Iron's 后，再回来挑这些会更容易判断价值。"]
			id: "4FF34B4D658BDB77"
			tasks: [{
				id: "73B4C7A9EDF47215"
				title: "法术"
				type: "checkmark"
			}]
			x: 0.0d
			y: -6.0d
		}
		{
			description: ["资源器官不一定直接加战斗力，但会让挖矿、采集、战利品和长期发育更舒服。科技宅家流尤其值得早看。"]
			id: "5C1BDFFCF420EAE6"
			tasks: [{
				id: "5A11308CA6B0BE42"
				title: "资源"
				type: "checkmark"
			}]
			x: 4.0d
			y: -6.0d
		}
		{
			description: ["辅助器官负责联动、触发、回流和特殊机制。前期不用急着看，等你已经有几件同源器官后再来补。"]
			id: "0EFD7B21C53CEC64"
			tasks: [{
				id: "441170F4C912C178"
				title: "体系内辅助：辅助器官负责联动、触发、回流和特殊机制。前期不用急着看，等你已经有几件同源器官后再来补。做出来后可以增强器官之间的协同效果。来源是器官系统的辅助方向。"
				type: "checkmark"
			}]
			x: 8.0d
			y: -6.0d
		}
		{
			description: ["蓄压爆发与机械采掘起点。这个器官来自 Create T1 工业系统，使用方法是安装到器官槽中，可以提高应力上限和近战爆发能力。做出来后适合工业路线玩家早期战斗强化。来源是 Create 工业模组。"]
			id: "44FBDB1D95A302FC"
			shape: "gear"
			size: 1.5d
			subtitle: "安山阶段粗机械器官"
