				type: "item"
			}]
			title: "寻找晶洞"
			x: 6.5d
			y: 9.0d
		}
		{
			dependencies: ["1D0200000000000F"]
			description: [
				"高品质宝石是插槽玩法真正开始的节点。"
				"它们能给武器和工具带来更明显的加成，所以晶洞不是可有可无的小彩蛋，而是你中期强化的一条正式路线。"
			]
			id: "1D02000000000010"
			tasks: [
				{
					id: "1D02000000000110"
					item: "tetra:pristine_lapis"
