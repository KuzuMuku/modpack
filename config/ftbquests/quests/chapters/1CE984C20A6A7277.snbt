		}
		{
			dependencies: ["0F4862A6CD6EA6B5"]
			description: ["放下一张床，右键即可设置重生点。围绕床、熔炉和箱子建立第一个补给点。之后探索地牢、村庄和矿洞都会轻松很多。 "]
			id: "1E01000000000009"
			tasks: [{
