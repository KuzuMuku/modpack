			}]
			title: "下界之星：解锁暮色"
			x: 8.0d
			y: 0.0d
		}
		{
			dependencies: ["2378779C503E0B15"]
			description: ["猪灵会主动攻击没有穿金甲的玩家。先做一双金靴，再考虑在堡垒和玄武岩三角洲附近活动。"]
			id: "1B01000000000003"
			tasks: [{
