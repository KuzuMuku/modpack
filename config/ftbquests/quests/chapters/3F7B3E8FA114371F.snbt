			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["5788967FDC7A21DC"]
			description: ["轴、齿轮和皮带决定动力往哪走。只要你能看懂一条动力线从哪里来、到哪里去，后面的机器就不会像一堆谜语。"]
			id: "717FC5B29020E001"
			tasks: [{
				id: "104959E14377C811"
				title: "传动技术"
				type: "checkmark"
			}]
			x: 2.0d
			y: -1.5d
		}
		{
			dependencies: ["717FC5B29020E001"]
			description: ["轴和皮带连接器是最基础的直线传力手段。不会拉轴和挂皮带，就还没真正进入 Create。 "]
			id: "162CA9E2D1247D1A"
