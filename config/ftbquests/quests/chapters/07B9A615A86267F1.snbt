{
	default_hide_dependency_lines: false
	default_quest_shape: ""
	filename: "07B9A615A86267F1"
	group: "6B135ADAEF98CFDF"
	icon: "irons_spellbooks:artificer_cane"
	id: "07B9A615A86267F1"
	order_index: 2
	quest_links: [ ]
	quests: [
		{
			dependencies: ["1E01000000000006"]
			description: [
				"§6Iron's Spellbooks 是本整合包最适合当主输出的法术体系之一。§r"
				"它的核心思路不是像 Ars 那样自己拼法术逻辑，而是围绕“职业成长”去升级法术书、抄录卷轴、强化装备，再慢慢收束到 1 到 2 个主修学校。"
				"推荐入门门槛是：你已经有稳定铁装或更好的护甲、能稳定拿经验、愿意给法术栏留出固定功能位。"
				"§a如果你想要的是一条真正能打主线、刷结构、清怪群、兼顾保命与位移的法师路线，这一章需要认真做，而不是只顺手拿一本到处丢技能。§r"
			]
			id: "7B02000000000000"
			optional: true
			tasks: [{
				id: "7B02000000000100"
				title: "路线导读"
				type: "checkmark"
			}]
			x: -4.0d
			y: 0.0d
		}
		{
			dependencies: ["1E01000000000006"]
			description: [
				"Iron's Spellbooks 和 Ars Nouveau 很不一样。"
				"Ars 更像自定义法术工具箱，而 Iron's 更像围绕战斗职业成长的施法体系。"
				"铜制法术书就是这条线的起点：你不再只是拿工具解决问题，而是开始认真把法术当成主战手段。"
			]
			id: "7B01000000000001"
			tasks: [{
				id: "7B01000000000101"
				item: "irons_spellbooks:copper_spell_book"
				type: "item"
			}]
			title: "铜制法术书"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["7B01000000000001"]
			description: [
				"§6先把 Iron's 当成“法术职业栏”，不要当成附魔弓的替代品。§r"
				"新手最稳的起步方式是准备 4 类法术位：`一个稳定单体输出`、`一个群怪或范围技能`、`一个保命位移`、`一个回复或减伤`。"
				"第一次配栏时，宁可技能少一点，也要分工明确。只要你把这四格安排清楚，Iron's 就会比普通近战和弓箭更稳。"
				"§e最常见的错误是把书塞满花技能，却没有回复位和撤退位。§r那样看起来像法师，实际打起来非常脆。"
			]
			id: "7B02000000000001"
			optional: true
			tasks: [{
				id: "7B02000000000101"
				title: "先学会怎么施法"
				type: "checkmark"
			}]
			x: -2.0d
			y: -2.0d
		}
		{
			dependencies: ["7B01000000000001"]
			description: [
				"铁制法术书可以理解成“真正开始玩 Iron's”之前的门槛。"
				"升级到这里以后，你的法术承载能力、成长空间和实战稳定性都会明显好很多。"
				"建议从这一步开始认真留意自己常用的法术学校和战斗距离，不要什么都学一点，最后谁都不成型。"
			]
			id: "7B01000000000002"
			tasks: [{
				id: "7B01000000000102"
				item: "irons_spellbooks:iron_spell_book"
				type: "item"
			}]
			title: "铁制法术书"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["7B01000000000001"]
			description: [
				"抄写台负责把卷轴、墨水和法术真正接到你的成长流程里。"
				"你会在这里接触“卷轴不是一次性垃圾，而是法术学习材料”这个关键概念。前期别急着把捡到的卷轴全乱用，先看看能不能转化成更稳定的法术积累。"
				"对新手来说，这个方块意味着 Iron's 从“捡技能”正式进入“培养技能”。"
			]
			id: "7B02000000000002"
			tasks: [{
				id: "7B02000000000102"
				item: "irons_spellbooks:inscription_table"
				type: "item"
			}]
			title: "抄写台"
			x: 0.0d
			y: 2.0d
		}
		{
			dependencies: ["7B02000000000002"]
			description: [
				"普通墨水是你开始稳定抄录与管理卷轴的起点材料。"
				"后面随着法术等级提高，你会逐渐需要更高级的墨水，所以现在就要建立一个习惯：看到关键卷轴先留着，等你有更好的书和更好的墨水时再决定怎样投入。"
				"这会比拿到一张卷轴就立刻消费更划算。"
			]
			id: "7B02000000000003"
			tasks: [{
				id: "7B02000000000103"
				item: "irons_spellbooks:common_ink"
				type: "item"
			}]
			title: "普通墨水"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["7B01000000000001"]
			description: [
				"施法器会直接改变你的施法节奏、攻击距离和战斗手感。"
				"先做一件简单的手杖或法杖，然后多打几场实战，确认自己到底喜欢站桩施法、拉扯施法，还是边跑边丢技能。"
				"Iron's 这条线的强度，很大程度上取决于你找没找到顺手的施法节奏。"
			]
			id: "7B01000000000003"
			tasks: [{
				id: "7B01000000000103"
				item: "irons_spellbooks:artificer_cane"
				type: "item"
			}]
			title: "施法器"
			x: 0.0d
			y: 4.0d
		}
		{
			dependencies: ["7B02000000000003"]
			description: [
				"卷轴锻炉让你开始主动制造法术，而不是被动等掉落。"
				"这一步很关键，因为它决定你能否围绕某个学校持续补全技能链。一个真正成型的 Iron's 玩家，不是捡到什么就用什么，而是知道自己缺的是位移、保命还是输出，并主动补那一段。"
				"从这里开始，你就应该有意识地经营自己的法术库。"
			]
			id: "7B02000000000004"
			tasks: [{
				id: "7B02000000000104"
				item: "irons_spellbooks:scroll_forge"
				type: "item"
			}]
			title: "卷轴锻炉"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: ["7B01000000000002"]
			description: [
				"奥术锭是这条线很多正式配方的中间层。"
				"做到这一步，说明你已经不再只是靠捡来的书和卷轴打架，而是开始真正进入 Iron's 自己的工艺体系。"
				"你可以把它理解成一句话：从现在开始，你做的每件装备都会更像一个职业构筑，而不只是附带会放法术。"
			]
			id: "7B01000000000004"
			tasks: [{
				id: "7B01000000000104"
				item: "irons_spellbooks:arcane_ingot"
				type: "item"
			}]
			title: "奥术锭"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["7B01000000000002"]
			description: [
				"奥术精华是很多进阶工艺和法术材料的共同底层。"
				"看到它时要意识到一件事：你的成长已经不再只靠金属和书，而是开始需要一条真正的魔法材料线。今后做高阶书、护甲、卷轴和特殊法器时，它会频繁出现。"
				"建议你尽早把它列入常备材料。"
			]
			id: "7B02000000000005"
			tasks: [{
				id: "7B02000000000105"
				item: "irons_spellbooks:arcane_essence"
				type: "item"
			}]
			title: "奥术精华"
			x: 4.0d
			y: -2.0d
		}
		{
			dependencies: ["7B01000000000002"]
			description: [
				"金制法术书是前中期很重要的过渡书。"
				"如果你觉得铜书和铁书已经开始不够装，或者施法上限明显卡住了，就应该把它当成下一步目标。书本等级越高，你能塞进来的法术与成长空间就越大。"
				"很多人觉得铁魔法弱，实际上只是还停在太低级的书本阶段。"
			]
			id: "7B02000000000006"
			tasks: [{
				id: "7B02000000000106"
				item: "irons_spellbooks:gold_spell_book"
				type: "item"
			}]
			title: "金制法术书"
			x: 4.0d
			y: 4.0d
		}
		{
			dependencies: ["7B02000000000006"]
			description: [
				"钻石法术书说明你已经不只是把法术当副手功能，而是真正把它当主职业。"
				"从这一步开始，建议你彻底收束主修学校，只保留极少量跨学校保命法术。主输出、主控场和主位移尽量围绕同一套装备词条走，强度会比杂修高很多。"
				"如果你想把铁魔法玩成主线核心，这一本到位后就会明显有感觉。"
			]
			id: "7B02000000000007"
			tasks: [{
				id: "7B02000000000107"
				item: "irons_spellbooks:diamond_spell_book"
				type: "item"
			}]
			title: "钻石法术书"
			x: 6.0d
			y: 4.0d
		}
		{
			dependencies: ["7B01000000000004"]
			description: [
				"秘银锭代表你已经开始接触 Iron's 的正式装备材料线。"
				"它通常意味着更高阶的装备、书本和职业护甲目标已经提上日程。实际发展上，拿到秘银之后就该开始考虑你到底准备走火、冰、雷、神圣、末影、鲜血还是其他学派，而不是继续什么都碰一点。"
			]
			id: "7B02000000000008"
			tasks: [{
				id: "7B02000000000108"
				item: "irons_spellbooks:mithril_ingot"
				type: "item"
			}]
			title: "秘银锭"
			x: 6.0d
			y: -2.0d
		}
		{
			dependencies: ["7B01000000000004"]
			description: [
				"奥术铁砧承担 Iron's 的职业化成长。"
				"你后面很多与法术装备、法术强化和构筑收束有关的内容，都会在这里展开。"
				"如果说法术书决定你会什么法术，这个铁砧决定的就是你准备把这些法术玩成什么流派。"
			]
			id: "7B01000000000005"
			tasks: [{
				id: "7B01000000000105"
				item: "irons_spellbooks:arcane_anvil"
				type: "item"
			}]
			title: "奥术铁砧"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["7B01000000000005"]
			description: [
				"§6先别急着做全套职业甲，先想清楚你想成为什么样的法师。§r"
				"火系更像直白的爆发清怪，冰系偏控制与风筝，雷系擅长连锁与机动，神圣偏回复与团队容错，末影偏位移与规避，鲜血偏吸血与高压换血，唤法偏召唤和控场，自然偏减速、毒与杂项工具。"
				"§e学校一旦选定，你后面的护甲、词条、常用卷轴、施法距离和站位都会一起跟着变。§r所以主修不要乱换，副修才用来补洞。"
			]
			id: "7B02000000000009"
			optional: true
			tasks: [{
				id: "7B02000000000109"
				title: "门派导览"
				type: "checkmark"
			}]
			x: 8.0d
			y: -3.0d
		}
		{
			dependencies: ["7B02000000000009"]
			description: [
				"§6按这套整合包的主线节奏，新手最稳的主修通常是火焰、雷电、鲜血三系。§r"
				"火焰胜在简单直接、清怪快；雷电胜在爆发和群伤都高；鲜血胜在能把输出和续航绑在一起。冰霜很稳，但更偏控制；神圣与末影极强，却更适合作为副修保命学校。"
				"§a如果你不确定先玩哪条，优先级可以简单记成：火焰入门，雷电进阶，鲜血激进，神圣/末影补容错。§r"
			]
			id: "7B0200000000001C"
			optional: true
			tasks: [{
				id: "7B0200000000011C"
				title: "当前强势学派推荐"
				type: "checkmark"
			}]
			x: 8.0d
			y: -5.0d
		}
		{
			dependencies: ["7B02000000000009"]
			description: [
				"火焰学派最适合想快速建立主输出的新手。"
				"它的特点是弹道直观、爆炸和持续灼烧多、清怪效率高，面对普通结构和地面怪群时非常省心。代价是很多技能更偏正面推进，保命和容错通常要靠跨学校补位。"
				"如果你就想先拥有一条可靠的主线火力，火系通常是最好上手的答案。"
			]
			id: "7B0200000000000A"
			optional: true
			tasks: [{
				id: "7B0200000000010A"
				title: "火焰学派"
				type: "checkmark"
			}]
			x: 10.0d
			y: -5.0d
		}
		{
			dependencies: ["7B0200000000000A"]
			description: [
				"火系常带法术推荐很明确。"
				"前期优先带 `Firebolt` 当稳定单体输出；拿到更多法术后，补 `Scorch` 或 `Flaming Barrage` 处理怪群和移动战；遇到需要一锤定音的目标，再用 `Fireball` 做高爆发收尾。"
				"如果你主修火系，副修最好补一个 `Heal`、`Teleport` 或 `Evasion`，因为火系自己解决保命的能力不算顶尖。"
			]
			id: "7B0200000000001D"
			optional: true
			tasks: [{
				id: "7B0200000000011D"
				title: "火系常带法术"
				type: "checkmark"
			}]
			x: 10.0d
			y: -7.0d
		}
		{
			dependencies: ["7B02000000000009"]
			description: [
				"冰霜学派偏向减速、冻结、控场和拉扯。"
				"它的价值不只是伤害，而是把危险怪物的节奏打断，让你有空间安全施法、撤退或接下一段连招。对于新手来说，冰系常常比纯爆发更稳，因为它能先让敌人不好好动。"
				"如果你不喜欢站桩对轰，而更喜欢风筝和压制，冰系会很好用。"
			]
			id: "7B0200000000000B"
			optional: true
			tasks: [{
				id: "7B0200000000010B"
				title: "冰霜学派"
				type: "checkmark"
			}]
			x: 12.0d
			y: -5.0d
		}
		{
			dependencies: ["7B0200000000000B"]
			description: [
				"冰系推荐带 `Icicle` 或 `Ray of Frost` 做稳定起手。"
				"`Ray of Frost` 更像持续挂冻结，`Icicle` 更像直线点杀；中期补 `Ice Spikes` 处理成排怪物，再用 `Frostbite` 或其他冻结联动法术把控制转成伤害。"
				"冰系最强的时候，不是你一发秒人，而是敌人根本打不出完整节奏。"
			]
			id: "7B0200000000001E"
			optional: true
			tasks: [{
				id: "7B0200000000011E"
				title: "冰系常带法术"
				type: "checkmark"
			}]
			x: 12.0d
			y: -7.0d
		}
		{
			dependencies: ["7B02000000000009"]
			description: [
				"雷电学派通常兼顾高爆发、连锁伤害和机动。"
				"它很适合处理中型怪群、快速点杀高优先级目标，或者用位移类雷法调整站位。雷系的节奏往往比火系更灵活，但也更依赖你准确判断施法时机和站位。"
				"如果你喜欢高压快节奏法师，雷系是非常强的主修。"
			]
			id: "7B0200000000000C"
			optional: true
			tasks: [{
				id: "7B0200000000010C"
				title: "雷电学派"
				type: "checkmark"
			}]
			x: 14.0d
			y: -5.0d
		}
		{
			dependencies: ["7B0200000000000C"]
			description: [
				"雷系是本包非常值得主修的高强度路线。"
				"前期先带 `Lightning Bolt` 做远程精准打击；近中距离清场时用 `Electrocute`；怪多时补 `Chain Lightning`；进入中后期后，`Thunderstorm` 会成为非常夸张的持续压场技能。"
				"如果你喜欢高强度主输出，又不想像鲜血那样贴脸冒险，雷系通常是最优解之一。"
			]
			id: "7B0200000000001F"
			optional: true
			tasks: [{
				id: "7B0200000000011F"
				title: "雷系常带法术"
				type: "checkmark"
			}]
			x: 14.0d
			y: -7.0d
		}
		{
			dependencies: ["7B02000000000009"]
			description: [
				"神圣学派是整条线里最适合补容错的学校。"
				"治疗、增益、减伤、飞行和对亡灵优势让它在主线远征里非常舒服。纯神圣并不一定是最高输出，但对新手而言，它能显著降低死亡率和补给压力。"
				"如果你总觉得自己不是打不过，而是容易出事，那就该认真考虑神圣法术。"
			]
			id: "7B0200000000000D"
			optional: true
			tasks: [{
				id: "7B0200000000010D"
				title: "神圣学派"
				type: "checkmark"
			}]
			x: 10.0d
			y: -3.0d
		}
		{
			dependencies: ["7B0200000000000D"]
			description: [
				"神圣系最推荐作为全职业通用副修。"
				"最低配都建议带一个 `Heal`；中期有条件时升级成 `Greater Heal`。跑图和空战非常推荐 `Angel Wing`，而 `Sunbeam` 与 `Guiding Bolt` 则能在需要时补出不错的远程与辅助输出。"
				"一句话概括：你不一定主修神圣，但你很少会后悔书里留一个神圣法术位。"
			]
			id: "7B02000000000020"
			optional: true
			tasks: [{
				id: "7B02000000000120"
				title: "神圣系常带法术"
				type: "checkmark"
			}]
			x: 10.0d
			y: -1.0d
		}
		{
			dependencies: ["7B02000000000009"]
			description: [
				"末影学派偏位移、规避、瞬移、回收与空间工具。"
				"它经常不是靠面板伤害取胜，而是让你总能站在更安全的位置，或在出事时立刻脱战。对跑图、打结构、处理高空环境和强行脱离包围特别有价值。"
				"如果你已经有主输出学校，末影通常是最值得副修的保命学派之一。"
			]
			id: "7B0200000000000E"
			optional: true
			tasks: [{
				id: "7B0200000000010E"
				title: "末影学派"
				type: "checkmark"
			}]
			x: 12.0d
