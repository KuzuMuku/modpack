		}
		{
			dependencies: [
				"2FC46B442848878E"
				"2D05000000000002"
				"493BF3DC21914799"
			]
			description: [
				"巨魔洞穴能提供进入最终高原前的重要材料。"
				""
				"标准流程是先下洞击杀怪物获取魔豆，将魔豆种在沃土上后爬藤蔓上云，击杀云上的巨人后用巨人镐挖掘巨型黑曜石，获取宝箱中的火焰灯来烧穿荆棘。"
				""
				"然而大部分玩家都是直接搭方块上云击杀巨人，毕竟魔豆掉落率并不高。"
			]
			id: "7E23B05915EDDC53"
			tasks: [{
				entity: "twilightforest:troll"
				id: "0A036A47E06FC815"
				type: "kill"
