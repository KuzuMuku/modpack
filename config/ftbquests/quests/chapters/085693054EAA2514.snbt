	quests: [
		{
			dependencies: ["1E01000000000007"]
			description: [
				"下界不是进来逛一圈就走的地方。第一次来，先把路认清，再把回程点和补给点放好。"
				"最先该拿的是烈焰棒，因为它会把酿造、末影之眼和后续主线都打开。之后再慢慢补远古残骸、凋灵骷髅头和下界器官。"
				"你只要能围绕重生锚、金靴和几个固定落脚点稳定往返，下界就会从高压地图变成稳定资源区。"
			]
			id: "1B01000000000000"
			tasks: [{
				id: "1B01000000000100"
				title: "阶段导读：下界远征"
				type: "checkmark"
			}]
			x: -2.0d
			y: 0.0d
		}
		{
			dependencies: ["1E01000000000007"]
			description: ["穿过传送门后，先寻找下界要塞与烈焰人。"]
			id: "2378779C503E0B15"
			tasks: [{
				dimension: "minecraft:the_nether"
				id: "2455C278DBEB1F21"
				type: "dimension"
			}]
			title: "踏入炼狱"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["2378779C503E0B15"]
			description: [
				"§6下界第一目标永远是烈焰棒，不是逛图。§r"
				"进门后先确认撤退路线，再找下界要塞和烈焰人。只有拿到烈焰棒，你才算真正打开了酿造、末影之眼、药水和后续主线。"
				"如果一进来就开始贪遗迹、堡垒或奇怪结构，很容易把自己卡在没有补给的半路上。对新手来说，最稳的做法是先把路线打通，再原路回头刷资源。"
			]
			id: "1CB3C4648B41ACAE"
			tasks: [{
				id: "5A463A3E29D50D40"
				item: "minecraft:blaze_rod"
				type: "item"
			}]
			title: "烈焰堡垒"
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["2378779C503E0B15"]
			description: ["远古残骸通常出现在下界深层。准备好床爆或高效率镐，再进行系统性挖掘。"]
			id: "5ABC25487AA3A531"
			tasks: [{
				id: "5613D513D17F913C"
				item: "minecraft:ancient_debris"
				type: "item"
			}]
			title: "远古残骸"
			x: 2.0d
			y: 2.0d
		}
		{
			dependencies: ["5ABC25487AA3A531"]
			description: [
				"§6远古残骸是下界的第二个大门槛。§r"
				"你要做的不是零散捡几个，而是先准备足够的矿镐、床爆或其他高效挖掘手段，然后按层系统清理。"
				"把远古残骸烧成下界合金碎片，再与金锭合成为下界合金锭。做到这一步，才算真的从“下界生存”进入“下界强化”。"
			]
			id: "6D7ACF4275464A59"
			tasks: [{
				id: "45942BD49975FFCC"
				item: "minecraft:netherite_ingot"
				type: "item"
			}]
			title: "下界合金"
			x: 4.0d
			y: 2.0d
		}
		{
			dependencies: [
				"1CB3C4648B41ACAE"
				"6D7ACF4275464A59"
			]
			description: ["开始系统刷取凋灵骷髅头。建议在要塞里清出生点、准备盾牌与远程手段。"]
			id: "7B4735AEEFE36E50"
			tasks: [{
				count: 3L
				id: "4BF8BB6548A394BA"
				item: "minecraft:wither_skeleton_skull"
				type: "item"
			}]
			title: "凋灵骷髅"
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["7B4735AEEFE36E50"]
			description: [
				"§c凋灵是检验你是否已经能稳定打下界内容的分界点。§r"
				"不要在资源不够的时候强开。先准备战场、奶、金苹果、回复药水和足够的撤退空间，再去打。"
				"如果你连烈焰棒、下界合金和稳定路线都还没有，就说明你还没到碰它的时机。"
			]
			id: "03FD01CEF237C049"
			tasks: [{
				entity: "minecraft:wither"
				id: "684055B3A17416C9"
				type: "kill"
				value: 1L
			}]
			title: "不死君王"
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: ["03FD01CEF237C049"]
			description: ["拿到下界之星，代表你已经完成了下界阶段的核心挑战，可以前往暮色森林。"]
			id: "654A8A0E9770844D"
			rewards: [{
				auto: "invisible"
