	quest_links: [ ]
	quests: [
		{
			dependencies: ["1E01000000000001"]
			description: [
				"§6Tetra 的重点是改造，不是合成一把固定成品。§r"
				"先把手边的剑、镐、斧放进工作台，看看它们能换什么部件。你会慢慢发现，同一把武器可以为了攻速、伤害、耐久或手感走不同方向。"
				"前期先把常用工具改顺手，中期再学修理、磨砺和全息球，后期才去遗迹找高级工坊。"
				"如果你刚接触 Tetra，不要急着抄毕业模板。先把一把主武器养明白。"
			]
			id: "1D02000000000000"
			optional: true
			tasks: [{
				id: "1D02000000000100"
				title: "路线导读"
				type: "checkmark"
			}]
			x: -1.5d
			y: 7.0d
		}
		{
			dependencies: ["1E01000000000001"]
			description: [
				"Tetra 不是“做一把成品武器”就结束的模组，而是“先做底子，再不断改造”的武器工坊。"
				"第一步先摆下基础工作台。之后你会围绕它拆装部件、观察可改槽位、比较不同材料的手感，慢慢把一件武器打磨成适合自己的版本。"
			]
			id: "1D01000000000001"
			tasks: [{
				id: "1D01000000000101"
				item: "tetra:basic_workbench"
				type: "item"
			}]
			title: "基础工作台"
			x: 2.5d
			y: 7.0d
		}
		{
			dependencies: ["1D01000000000001"]
			description: [
				"最开始先拿原版木剑、石镐、斧头这类你本来就会做的东西练手。"
				"Tetra 很多工具都不是从零开始硬做，而是把原版物品放进工作台里升级。对新手来说，这样最容易理解，也最省前期材料。"
				"所以第一目标不是立刻追模块化毕业武器，而是先学会把手边常用工具改得更顺手。"
			]
			id: "1D02000000000001"
			optional: true
			tasks: [{
				id: "1D02000000000101"
				title: "先从原版工具改起"
				type: "checkmark"
			}]
			x: 2.5d
			y: 5.0d
		}
		{
			dependencies: ["1D01000000000001"]
			description: [
				"锻造锤是 Tetra 真正开始运作的关键工具。"
				"有了它，你才能拆下武器原本的部件、换上新材料、查看不同模组位的改装方向。"
				"如果你以前只会直接合成武器，这一步就是从“做装备”过渡到“调装备”的分水岭。"
			]
			id: "1D01000000000002"
			tasks: [{
				id: "1D01000000000102"
				item: "tetra:hammer_base"
				type: "item"
			}]
			title: "锻造锤"
			x: 4.5d
			y: 7.0d
		}
		{
			dependencies: ["1D01000000000002"]
			description: [
				"锤阶决定你能改什么。"
				"新手最重要的节奏就是一路把锤子从低阶往上推：石锤解决最初级改造，铁锤开始稳定进入工作台循环，黑石锤才能承接更多中期模块，后面更高阶锤则与遗迹和高级工坊挂钩。"
				"如果某个改造做不了，先别怀疑自己缺了隐藏配方，先看看是不是锤阶还不够。"
			]
			id: "1D02000000000002"
			optional: true
			tasks: [{
				id: "1D02000000000102"
				title: "先理解锤阶"
				type: "checkmark"
			}]
			x: 4.5d
			y: 5.0d
		}
		{
			dependencies: ["1D01000000000002"]
			description: [
				"石锤是你第一次真正体会 Tetra 进阶工艺的门槛。"
				"它不是毕业工具，但会告诉你一个很关键的概念：锤子本身也是要被一路升级的主工具。"
			]
			id: "1D02000000000003"
			optional: true
			tasks: [{
				id: "1D02000000000103"
				title: "目标：石锤"
				type: "checkmark"
			}]
			x: 6.5d
			y: 5.0d
		}
		{
			dependencies: ["1D02000000000003"]
			description: [
				"铁锤是前中期最重要的一次跨越。"
				"做到这一步后，你会明显感觉到能动的模块和材料突然多起来，很多“原来灰着”的方案开始亮了。"
			]
			id: "1D02000000000004"
			optional: true
			tasks: [{
				id: "1D02000000000104"
				title: "目标：铁锤"
				type: "checkmark"
			}]
			x: 8.5d
			y: 5.0d
		}
		{
			dependencies: ["1D02000000000004"]
			description: [
				"黑石锤标志着你已经能认真碰 Tetra 中期内容。"
				"如果你想继续往更高阶材料、遗迹模块和高级工坊走，这一阶通常是很重要的过渡。"
			]
			id: "1D02000000000005"
			optional: true
			tasks: [{
				id: "1D02000000000105"
				title: "目标：黑石锤"
				type: "checkmark"
			}]
			x: 10.5d
			y: 5.0d
		}
		{
			dependencies: ["1D01000000000002"]
			description: [
				"全息投影是 Tetra 最重要的读图工具。"
				"它会告诉你一件装备还能往哪些方向强化、每条强化缺什么材料、哪些升级需要特殊遗迹或工作台。"
				"新手玩 Tetra 时最容易犯的错，就是只看伤害数值，不看升级树；这个方块就是专门帮你避免这种情况的。"
			]
			id: "1D01000000000003"
			tasks: [{
				id: "1D01000000000103"
				item: "tetra:holo"
				type: "item"
			}]
			title: "全息投影"
			x: 6.5d
			y: 7.0d
		}
		{
			dependencies: ["1D01000000000003"]
			description: [
				"学会看全息球，比盲目改装重要得多。"
				"你要特别留意四件事：还有哪些槽位能开、某个升级要什么材料、完整性够不够、旁边有没有提示需要遗迹或特殊工坊。"
				"只要把这四点看熟，新手就不会再有“为什么别人的 Tetra 很强，我的只能加一点点伤害”的困惑。"
			]
			id: "1D02000000000006"
			optional: true
			tasks: [{
				id: "1D02000000000106"
				title: "学会看全息球"
				type: "checkmark"
			}]
			x: 8.5d
			y: 7.0d
		}
		{
			dependencies: ["1D01000000000002"]
			description: [
				"先从模块化剑开始最合适，因为它结构直观、成本不算夸张，适合练手。"
				"做到这一步后，不要急着追求最终毕业词条，先试着换一两种材料，体会攻速、耐久、伤害和附加效果之间的取舍。"
				"Tetra 的乐趣就在这里：不是一把更强的剑，而是一把更像你自己打法的剑。"
			]
			id: "1D01000000000004"
			tasks: [{
				id: "1D01000000000104"
				item: "tetra:modular_sword"
				type: "item"
			}]
			title: "模块化剑"
			x: 4.5d
			y: 9.0d
		}
		{
			dependencies: ["1D01000000000001"]
			description: [
				"模块化单手工具是 Tetra 对原版镐、斧、铲的一条总路线。"
				"如果你更在意采集效率、挖矿体验和综合工具手感，而不是先做武器，这一支非常适合先推进。"
			]
			id: "1D02000000000007"
			tasks: [{
				id: "1D02000000000107"
				item: "tetra:modular_single"
				type: "item"
			}]
			title: "模块化工具"
			x: 4.5d
			y: 3.0d
		}
		{
			dependencies: ["1D02000000000007"]
			description: [
				"Tetra 新手最容易感受到提升的，不是极限武器，而是镐子和斧头。"
				"因为你每天都在挖、砍、修、拆。优先把一把主力工具改到顺手，收益往往比硬做一把还不熟悉的奇怪武器更高。"
			]
			id: "1D02000000000008"
			optional: true
			tasks: [{
				id: "1D02000000000108"
				title: "先养一把主力工具"
				type: "checkmark"
			}]
			x: 6.5d
			y: 3.0d
		}
		{
			dependencies: ["1D01000000000004"]
			description: [
				"双手武器意味着你开始从“日常清怪”转向“围绕强敌和 Boss 调武器”。"
				"这类武器通常更重、更慢，但爆发更高，也更依赖你对前摇、站位和攻击节奏的掌握。"
				"如果你已经发现单手剑打高压战不够过瘾，这一步就是 Tetra 给你的第一条明确分流。"
			]
			id: "1D01000000000005"
			tasks: [{
				id: "1D01000000000105"
				item: "tetra:modular_double"
				type: "item"
			}]
			title: "重武器路线"
			x: 6.5d
			y: 9.0d
		}
		{
			dependencies: ["1D01000000000004"]
			description: [
				"模块化盾牌很适合不想放弃原版格挡节奏的新手。"
				"如果你主线阶段经常被远程、突进怪或高压近战打得难受，先把一面顺手的盾养起来，往往比一味追伤害舒服。"
			]
			id: "1D02000000000009"
			tasks: [{
				id: "1D02000000000109"
				item: "tetra:modular_shield"
				type: "item"
			}]
			title: "防守路线"
			x: 6.5d
			y: 11.0d
		}
		{
			dependencies: ["1D01000000000004"]
			description: [
				"模块化弓适合想把 Tetra 接到远程构筑的玩家。"
				"如果你已经在玩枪、弓或法师副手，这一支可以作为补充；但纯新手开荒时，它通常没有近战工具和主力工具那么优先。"
			]
			id: "1D0200000000000A"
			tasks: [{
				id: "1D0200000000010A"
				item: {
					Count: 1
					id: "tetra:modular_bow"
					tag: {
						Damage: 0
					}
				}
				type: "item"
			}]
			title: "远程路线"
			x: 8.5d
			y: 11.0d
		}
		{
			dependencies: ["1D01000000000004"]
			description: [
				"Tetra 有一个很重要但容易被忽略的点：修理。"
				"模块化物品不是坏了就丢，而是在工作台里用对应模块材料轮流修。不同模块还会轮换进修理序列，所以你要开始记住一把武器到底是用什么做的。"
				"会修，才配长期养。"
			]
			id: "1D0200000000000B"
			optional: true
			tasks: [{
				id: "1D0200000000010B"
				title: "先学会修理"
				type: "checkmark"
			}]
			x: 8.5d
			y: 9.0d
		}
		{
			dependencies: ["1D01000000000004"]
			description: [
				"磨砺 `Hone` 是 Tetra 真正把一把武器养起来的方式之一。"
				"简单理解，就是先把武器用出熟练度，再在工作台里继续打磨某些属性或某个改进。新手阶段不用强求极限数值，但一定要知道“武器会越用越能继续养”。"
			]
			id: "1D0200000000000C"
			optional: true
			tasks: [{
				id: "1D0200000000010C"
				title: "理解磨砺系统"
				type: "checkmark"
			}]
			x: 10.5d
			y: 9.0d
		}
		{
			dependencies: ["1D0200000000000C"]
			description: [
				"真正的新手友好打法，是先养一把顺手的主力武器，然后只围绕它做 1 到 2 个明确目标。"
				"例如单手剑就优先补攻速和稳定手感，双手武器就优先补重击收益，盾牌就优先补容错。不要同时追太多花哨词条，不然材料会被摊薄。"
			]
			id: "1D0200000000000D"
			optional: true
			tasks: [{
				id: "1D0200000000010D"
				title: "一次只养一把主武器"
				type: "checkmark"
			}]
			x: 12.5d
			y: 9.0d
		}
		{
			dependencies: [
				"1D01000000000003"
				"1D01000000000005"
			]
			description: [
				"锻造工作台代表你不再只是做临时改装，而是真的开始经营一间武器工坊。"
				"从这里开始，很多更深的模组位、材料路线和高级改造才会逐步打开。"
				"做到这一步后，Tetra 的正确玩法就不再是“照着配方做一个”，而是“拿一把顺手武器，持续迭代到整条主线都够用”。"
			]
			id: "1D01000000000006"
			tasks: [{
				id: "1D01000000000106"
				item: "tetra:forged_workbench"
				type: "item"
			}]
			title: "真正的工坊"
			x: 8.5d
			y: 8.0d
		}
		{
			dependencies: ["1D01000000000006"]
			description: [
				"从锻造工坊开始，很多更高级的模块都不再只靠主世界常规材料解决。"
				"你会需要去遗迹、拆旧结构、找特殊零件、甚至回头重做锤子。也就是说，这里是 Tetra 从“改装工具”转向“考古工坊”的节点。"
			]
			id: "1D0200000000000E"
			optional: true
			tasks: [{
				id: "1D0200000000010E"
				title: "中期开始看遗迹"
				type: "checkmark"
			}]
			x: 10.5d
			y: 7.0d
		}
		{
			dependencies: ["1D01000000000003"]
			description: [
				"晶洞是 Tetra 中期非常值得留意的资源点。"
				"深板岩区域里带微光的矿块有可能藏着晶洞，拿回工作台敲开后能出更优质的宝石。"
				"如果你已经开始认真养武器，这类宝石的收益会比普通宝石明显更高。"
			]
			id: "1D0200000000000F"
			tasks: [{
				id: "1D0200000000010F"
				item: "tetra:geode"
				type: "item"
			}]
			title: "寻找晶洞"
			x: 10.5d
			y: 3.0d
		}
		{
			dependencies: ["1D0200000000000F"]
			description: [
				"高品质宝石是插槽玩法真正开始的节点。"
				"它们能给武器和工具带来更明显的加成，所以晶洞不是可有可无的小彩蛋，而是你中期强化的一条正式路线。"
			]
			id: "1D02000000000010"
			tasks: [
				{
					id: "1D02000000000110"
					item: "tetra:pristine_lapis"
					type: "item"
				}
				{
					id: "1D02000000000111"
					item: "tetra:pristine_diamond"
					type: "item"
				}
			]
			title: "高品质宝石"
			x: 12.5d
			y: 3.0d
		}
		{
			dependencies: ["1D01000000000003"]
			description: [
				"全息球后续还能修复扫描功能。"
				"近距离扫描能帮你更好地确认遗迹方向，放在地上再用锤子敲击，则能做更远程的区块扫描。对第一次找古代遗迹的新手来说，这套功能非常重要。"
			]
			id: "1D02000000000011"
			optional: true
			tasks: [{
				id: "1D02000000000112"
				title: "修复扫描功能"
				type: "checkmark"
			}]
			x: 12.5d
			y: 7.0d
		}
		{
			dependencies: ["1D02000000000011"]
			description: [
				"古代遗迹通常生成在寒冷或山地深处。"
				"如果你在地底深层活动时看到奇怪的旧工坊、残骸或大型构件，不要只当成普通地牢，它们很可能就是 Tetra 真正的中后期入口。"
			]
			id: "1D02000000000012"
			optional: true
			tasks: [{
				id: "1D02000000000113"
				title: "寻找古代遗迹"
				type: "checkmark"
			}]
			x: 14.5d
			y: 7.0d
		}
		{
			dependencies: ["1D02000000000012"]
			description: [
				"平面稳定器是遗迹里很值得带回来的高级零件。"
				"它代表 Tetra 已经开始从常规改装走向真正的遗迹技术线，能服务于更强的弓、腰带或其他高级改造。"
			]
			id: "1D02000000000013"
			tasks: [{
				id: "1D02000000000114"
				item: "tetra:planar_stabilizer"
				type: "item"
			}]
			title: "平面稳定器"
			x: 16.5d
			y: 7.0d
		}
		{
			dependencies: ["1D02000000000013"]
			description: [
				"Tetra 到后面会越来越像“长期投资一两把装备”的模组。"
				"所以最适合新手的终极建议反而很简单：不要贪多，选一把近战主武器、一把主力工具，再视情况补一面盾或一把弓。把材料和时间集中投入，手感会比摊开养四五把装备好得多。"
			]
			id: "1D02000000000014"
