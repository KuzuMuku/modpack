	quest_links: [ ]
	quests: [
		{
			dependencies: ["1E01000000000001"]
			description: [
				"§6Tetra 的重点是改造，不是合成一把固定成品。§r"
				"先把手边的剑、镐、斧放进工作台，看看它们能换什么部件。你会慢慢发现，同一把武器可以为了攻速、伤害、耐久或手感走不同方向。"
				"前期先把常用工具改顺手，中期再学修理、磨砺和全息球，后期才去遗迹找高级工坊。"
				"如果你刚接触 Tetra，不要急着抄毕业模板。先把一把主武器养明白。"
			]
			id: "1D02000000000000"
			optional: true
			tasks: [{
				id: "1D02000000000100"
				title: "路线导读"
				type: "checkmark"
			}]
			x: -1.5d
			y: 7.0d
		}
		{
			dependencies: ["1E01000000000001"]
			description: [
				"Tetra 不是“做一把成品武器”就结束的模组，而是“先做底子，再不断改造”的武器工坊。"
				"第一步先摆下基础工作台。之后你会围绕它拆装部件、观察可改槽位、比较不同材料的手感，慢慢把一件武器打磨成适合自己的版本。"
			]
			id: "1D01000000000001"
			tasks: [{
				id: "1D01000000000101"
				item: "tetra:basic_workbench"
				type: "item"
			}]
			title: "基础工作台"
			x: 2.5d
			y: 7.0d
		}
		{
			dependencies: ["1D01000000000001"]
			description: [
				"最开始先拿原版木剑、石镐、斧头这类你本来就会做的东西练手。"
				"Tetra 很多工具都不是从零开始硬做，而是把原版物品放进工作台里升级。对新手来说，这样最容易理解，也最省前期材料。"
				"所以第一目标不是立刻追模块化毕业武器，而是先学会把手边常用工具改得更顺手。"
			]
			id: "1D02000000000001"
			optional: true
			tasks: [{
				id: "1D02000000000101"
				title: "先从原版工具改起"
				type: "checkmark"
			}]
			x: 2.5d
			y: 5.5d
		}
		{
			dependencies: ["1D01000000000001"]
			description: [
				"锻造锤是 Tetra 真正开始运作的关键工具。"
				"有了它，你才能拆下武器原本的部件、换上新材料、查看不同模组位的改装方向。"
				"如果你以前只会直接合成武器，这一步就是从“做装备”过渡到“调装备”的分水岭。"
			]
			id: "1D01000000000002"
			tasks: [{
				id: "1D01000000000102"
				item: "tetra:hammer_base"
				type: "item"
			}]
			title: "锻造锤"
			x: 4.5d
			y: 7.0d
		}
		{
			dependencies: ["1D01000000000002"]
			description: [
				"锤子与原版工具等级类似，只有高等级的锤子才能加工部分材料。"
				""
				"tetra很重要的主线节奏就是一路把锤子从低阶往上推：石锤解决最初级改造，铁锤开始稳定进入工作台循环，黑石锤才能承接更多中期模块，后面更高阶锤则与遗迹和高级工坊挂钩。"
				""
				"如果你发现了高级材料无法加工，界面提示需要高级锤子，记得回来看看如何提升你的锤子等级。"
			]
			id: "1D02000000000002"
			optional: true
			tasks: [{
				id: "1D02000000000102"
				title: "先理解锤阶"
				type: "checkmark"
			}]
			x: 4.5d
			y: 4.0d
		}
		{
			dependencies: ["1D01000000000002"]
			description: [
				"石锤为2级，一般是你第一把 Tetra 锤，可直接通过原版工作台合成。它会告诉你一个很关键的概念：锤子也是要被一路升级的主工具。"
				""
				"你至少需要两把同等级锤子才能稳定升级：一把被升级，一把用来敲上升级材料。"
				""
				"由于tetra工具的tag繁多，任务书容易匹配失败，上面的圆石锤是可选任务，请自行打勾为自己标记已完成。"
			]
