	id: "0FD713321E407D7B"
	order_index: 3
	quest_links: [ ]
	quests: [
		{
			dependencies: ["1E01000000000010"]
			description: [
				"Mekanism 是更重、更长线的工业路线。它适合你已经有固定基地，想把矿物处理、电力、装备和后期材料都交给机器的时候再认真推进。"
				"入门时先盯住锇矿、钢外壳和冶金灌注机。只要这三件事跑通，后面的电路、合金、基础机器和发电就会自然接上。"
				"这条线的收益很直接：矿物处理更高效，材料库存更稳定，后期还能提供强装备和高阶器官材料。代价也很明确：你需要愿意铺线、囤中间材料、维护能源。"
				"如果你只是想马上变强，先回去补装备和器官；如果你想让基地越滚越大，从这里开始投入就很划算。"
			]
			id: "0F02000000000000"
			tasks: [{
				id: "0F02000000000100"
				title: "路线导读"
				type: "checkmark"
			}]
			x: -2.0d
			y: -2.0d
		}
		{
			dependencies: ["0F02000000000000"]
			description: [
				"锇矿是 Mekanism 的第一张门票。看到它，就可以开始考虑把这条工业线接进你的基地。"
				"前期不用记住一长串机器名字。先记住一个短链：锇矿做底，钢外壳做机壳，冶金灌注机做电路和合金。"
				"只要这条短链顺了，后面的机器就不再是一堆陌生方块，而是一层一层往上升级。"
			]
			id: "00FCB842D31CF554"
			tasks: [{
				id: "137683E1A74876EA"
				item: "mekanism:osmium_ore"
				type: "item"
			}]
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["00FCB842D31CF554"]
			description: [
				"钢外壳可以理解为 Mekanism 的标准机壳。"
				"从这一步开始，你做的就不再是单独的材料，而是一套工业设备的骨架。"
				"从这里开始，你做的不是一台孤立机器，而是一整套工业骨架。最好早点给中间材料留箱子，不然后面会一直回来补零件。"
			]
			id: "5098210FD7A16120"
			tasks: [{
				id: "157E28CB6C44A949"
				item: "mekanism:steel_casing"
				type: "item"
			}]
			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["5098210FD7A16120"]
			description: [
				"冶金灌注机是 Mekanism 早期绝对的核心。"
				"你后面做电路、做合金、做更高层机器，几乎都会反复回到它。"
				"如果这章只能先学一台机器，就学它。后面的电路、合金和机器升级都会反复回到这里。"
			]
			id: "01740776D36A310A"
			tasks: [{
				id: "16B8D71E6D9B2A37"
				item: "mekanism:metallurgic_infuser"
				type: "item"
			}]
			x: 4.0d
			y: 0.0d
		}
		{
			dependencies: ["01740776D36A310A"]
			description: [
				"控制电路决定了你当前能进入哪一层工业等级。"
				"基础电路只是门票的第一层，但从这里开始，你会逐渐感受到 Mekanism 明确的等级制成长。"
				"看不懂后面一串机器也没关系，只要先明白：做更高机器，本质上就是在追更高阶电路和更高阶合金。"
			]
			id: "2EA0CFBC0379A309"
			tasks: [{
				id: "1654E1DD702A758E"
				item: "mekanism:basic_control_circuit"
				type: "item"
			}]
			x: 6.0d
			y: 0.0d
		}
		{
			dependencies: [
				"0D37EF84099A25A6"
				"2EA0CFBC0379A309"
			]
			description: [
				"到了进阶电路这一步，你已经不再只是‘玩玩基础机器’，而是开始往真正的工业体系过渡。"
				"从这里以后，建议你开始考虑自动输入输出、材料批量化和供电稳定性，不然每做一台新机器都会像重开一遍。"
			]
			id: "0003BAADADEA750C"
			tasks: [{
				id: "692878898789D7DF"
				item: "mekanism:advanced_control_circuit"
				type: "item"
			}]
			x: 6.0d
			y: 2.0d
		}
		{
			dependencies: [
				"0003BAADADEA750C"
				"19EAFC89520260D2"
			]
			description: [
				"精英电路和原子合金是 Mekanism 中期成熟度的证明。"
				"做到这里以后，你已经有能力支撑多方块、核线前置和更重型的自动化设施。"
				"如果你此时仍然是手搓为主，那接下来会越来越痛苦，最好尽快把常用材料做成批量化流程。"
			]
			id: "5BE22359954280E5"
			tasks: [{
				id: "06AC1C61A375F27D"
				item: "mekanism:elite_control_circuit"
				type: "item"
			}]
			x: 6.0d
			y: 4.0d
		}
		{
			dependencies: [
				"5BE22359954280E5"
				"4B6635D59401EBF2"
			]
			description: ["终极控制电路是 Mekanism 后期合成的主线材料，几乎所有高级机器与能量模块都要用，是电路链的最后一级。"]
			id: "5E3EB7067D1F1160"
			tasks: [{
				id: "3828D3562C14A971"
				item: "mekanism:ultimate_control_circuit"
				type: "item"
			}]
			x: 6.0d
			y: 6.0d
		}
		{
			dependencies: ["01740776D36A310A"]
			description: [
				"富集合金是 Mekanism 材料阶梯的第一层。"
				"从这一步开始，你要慢慢习惯“上一层合金是下一层机器的底材”这种递进关系。"
				"这条线真正难的不是某个单配方，而是你是否愿意把中间材料做成库存。"
			]
			id: "0D37EF84099A25A6"
