			x: 0.0d
			y: -12.5d
		}
		{
			dependencies: ["53975F7F0F432275"]
			description: ["魔力发射器是 `产魔` 和 `存魔` 之间的桥梁。很多新手有花也有池子，却不会传魔，问题通常就卡在这里。 "]
			id: "1761A61BEED14385"
			tasks: [{
