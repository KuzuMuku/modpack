			}]
			title: "巨魔洞穴"
			x: 11.5d
			y: -2.0d
		}
		{
			dependencies: ["5D34252C7B004BC2"]
			description: ["抵达最终高原意味着你已经完成暮色阶段的主线，至于最终boss？只能祝它好运吧，你可以继续前往天境了。"]
