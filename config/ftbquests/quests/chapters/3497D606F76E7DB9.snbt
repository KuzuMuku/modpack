			x: 2.0d
			y: 0.0d
		}
		{
			dependencies: ["3F13A1F623C22770"]
			description: ["巫妖高塔通常需要向上突破。建议带足方块、远程武器和解毒或回复手段。"]
			id: "56223D9D9485F1EE"
